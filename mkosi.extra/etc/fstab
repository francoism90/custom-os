# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>

# Root subvolume
LABEL=root-x86-64  /           btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@        0 0

# Additional subvolumes
LABEL=root-x86-64  /home       btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@home    0 0
LABEL=root-x86-64  /root       btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@root    0 0
LABEL=root-x86-64  /srv        btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@srv     0 0
LABEL=root-x86-64  /var/cache  btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@cache   0 0
LABEL=root-x86-64  /var/tmp    btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@tmp     0 0
LABEL=root-x86-64  /var/log    btrfs  defaults,noatime,compress=zstd,space_cache=v2,subvol=/@log     0 0

# tmpfs for /tmp (performance and security)
tmpfs              /tmp        tmpfs  rw,nosuid,nodev,size=4G                                         0 0

# ESP is auto-mounted by systemd-gpt-auto-generator at /efi or /boot/efi
