#!/bin/sh
set -ex

# Build initramfs and UKI using mkinitcpio presets
if command -v mkinitcpio >/dev/null; then
  mkinitcpio -P
fi

# Log UKI path if present
kver_dir=$(ls -1 /usr/lib/modules | head -n1)
[ -n "$kver_dir" ] && [ -e "/usr/lib/modules/$kver_dir/customos.efi" ] && echo "UKI: /usr/lib/modules/$kver_dir/customos.efi"
