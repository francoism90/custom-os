#!/bin/sh
set -ex

# Set password for archie user
# Default password: "archie" - CHANGE THIS IN PRODUCTION
echo "archie:archie" | chpasswd

# Configure passwordless sudo for wheel group (optional - remove if you want password prompt)
echo '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd
chmod 440 /etc/sudoers.d/wheel-nopasswd

echo "User 'archie' configured with password and sudo access"